[Desktop Entry]
Name=MCA Selector Plus
Comment=Select, edit, and export chunks of your Minecraft world
Exec=/opt/mcaselector-plus/bin/mcaselector-plus
Terminal=false
Type=Application
Icon=/opt/mcaselector-plus/lib/mcaselector-plus.png
Categories=Game;GameTool;Java;
StartupWMClass=net.querz.mcaselector.ui.Window
# the desktop entry spec version, not the application version
Version=1.5
# application version, both layers: <upstream> - Plus <plus layer>
X-MCA-Selector-Version=2.9 - Plus 1.2
